#!/bin/sh
# Auto-update apphosting.yaml URL based on branch.
# NOTE for forks: swapunits.com/unitswap.xyz are this project's own domains
# (Bugierek/SwapUnitsWebApp). If you forked this repo, either replace them
# below with your own domain(s) or delete this hook - it's not required for
# the app to run, just a convenience for this project's specific deploy setup.

BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "master" ]; then
  sed -i '' 's|value: https://unitswap.xyz|value: https://swapunits.com|g' apphosting.yaml
elif [ "$BRANCH" = "dev" ]; then
  sed -i '' 's|value: https://swapunits.com|value: https://unitswap.xyz|g' apphosting.yaml
fi
